# 서버 전용 — 절대 VITE_ 접두어를 붙이지 않는다 (Vite는 VITE_ 변수를 브라우저 번들에 넣는다)
KIPRIS_API_KEY=
KIPRIS_GATEWAY=auto            # auto | kipo | openapi
KIPRIS_SCHEME=https            # S5 실측: https 통함 (http도 통함)
KIPRIS_DAILY_LIMIT=300          # 추정값 (S6 미확인)
KIPRIS_REGISTRATION_MONTHLY_LIMIT=900   # 등록사항 API: 공공데이터포털 안내 월 1,000건 무료 기준 여유분

LLM_PROVIDER=anthropic         # anthropic | openai
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_MODEL=
LLM_DAILY_REPORTS=30

DATABASE_URL=                  # Neon 통합이 설정. 비워 두면 로컬 개발에서 PGlite(.data/)를 쓴다
APP_ACCESS_CODE=               # 비워 두면 로컬 개발에서는 접근 코드 없이 열린다. 운영에서는 필수
APP_SESSION_SECRET=            # 운영에서는 필수 (긴 무작위 문자열)

# ---- 로컬 시연용 (운영에서는 쓰지 않는다) ----
# KIPRIS_MOCK=1                # 가상 KIPRIS 응답 (4.4 fixtures). 결과는 실제 특허가 아니다
# LLM_PROVIDER=mock            # 가짜 LLM. 실제 분석이 아니다
